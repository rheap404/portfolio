---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />
        <title>Thailand Trip: Day by Day</title>
    </head>
    <body>
        <header>
            <h1>Thailand · 9–16 Nov 2026</h1>
            <nav id="nav" aria-label="Days">
                {
                    days.map((day, i) => (
                        <button
                            type="button"
                            data-i={i}
                            aria-current={i === 0 ? "true" : "false"}
                        >
                            {day.n}
                        </button>
                    ))
                }
            </nav>
        </header>

        <main id="main">
            {
                days.map((day, i) => (
                    <section
                        class="day"
                        data-i={i}
                        style={`--acc:${accents[day.c]}`}
                        hidden={i !== 0}
                    >
                        <div class="hero">
                            <small>
                                {day.d} · Day {i + 1} of {days.length}
                            </small>
                            <h2>{day.t}</h2>
                        </div>

                        <div class="stay">
                            <b>Sleep</b>
                            {day.s}
                        </div>

                        <ol>
                            {day.r.map(([time, title, note]) => (
                                <li>
                                    <div class="t">{time}</div>
                                    <div class="x">
                                        <b>{title}</b>
                                        {note && <span>{note}</span>}
                                    </div>
                                </li>
                            ))}
                        </ol>

                        <details>
                            <summary>More things to do</summary>
                            <ul>
                                {day.m.map((item) => (
                                    <li>{item}</li>
                                ))}
                            </ul>
                        </details>

                        <div class="pn">
                            <button type="button" class="pv" disabled={i === 0}>
                                ← Back
                            </button>
                            <button
                                type="button"
                                class="nx"
                                disabled={i === days.length - 1}
                            >
                                Next →
                            </button>
                        </div>
                    </section>
                ))
            }
        </main>
    </body>
</html>

<style is:global>
    :root {
        --bg: #f4f6f8;
        --card: #fff;
        --fg: #1d2733;
        --mut: #5f6b7a;
        --line: #e1e6ec;
        --acc: #2e75b6;
        box-sizing: border-box;
        padding-top: env(safe-area-inset-top, 0px);
        padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
            --bg: #10151b;
            --card: #1a222b;
            --fg: #e8edf2;
            --mut: #9aa7b5;
            --line: #2a3541;
        }
    }
    :root[data-theme="dark"] {
        --bg: #10151b;
        --card: #1a222b;
        --fg: #e8edf2;
        --mut: #9aa7b5;
        --line: #2a3541;
    }
    html {
        scroll-padding-top: env(safe-area-inset-top, 0px);
    }
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }
    body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font:
            16px/1.45 -apple-system,
            system-ui,
            "Segoe UI",
            Roboto,
            Arial,
            sans-serif;
    }
    body::before {
        content: "";
        position: fixed;
        inset: 0 0 auto;
        height: env(safe-area-inset-top, 0px);
        background: var(--bg);
        z-index: 6;
    }
    header {
        position: sticky;
        top: env(safe-area-inset-top, 0px);
        z-index: 5;
        background: var(--bg);
        border-bottom: 1px solid var(--line);
    }
    h1 {
        font-size: 15px;
        margin: 0;
        padding: 10px 14px 4px;
        color: var(--mut);
        font-weight: 600;
    }
    #nav {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        padding: 4px 14px 10px;
        scrollbar-width: none;
    }
    #nav button {
        flex: 0 0 auto;
        border: 1px solid var(--line);
        background: var(--card);
        color: var(--fg);
        border-radius: 999px;
        padding: 7px 13px;
        font: 600 14px inherit;
        font-family: inherit;
    }
    #nav button[aria-current="true"] {
        background: var(--acc);
        border-color: var(--acc);
        color: #fff;
    }
    main {
        padding: 14px;
        max-width: 640px;
        margin: 0 auto;
    }
    .day[hidden] {
        display: none;
    }
    .hero {
        background: var(--acc);
        color: #fff;
        border-radius: 16px;
        padding: 16px;
    }
    .hero small {
        opacity: 0.85;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .hero h2 {
        margin: 4px 0 0;
        font-size: 22px;
        line-height: 1.2;
    }
    .stay {
        margin: 12px 0;
        background: var(--card);
        border: 1px solid var(--line);
        border-left: 5px solid var(--acc);
        border-radius: 12px;
        padding: 10px 12px;
        font-size: 14px;
    }
    .stay b {
        display: block;
        color: var(--mut);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    ol {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    ol > li {
        display: flex;
        gap: 12px;
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 11px 12px;
        margin-bottom: 8px;
    }
    .t {
        flex: 0 0 64px;
        font-weight: 700;
        color: var(--acc);
        font-size: 14px;
    }
    .x b {
        display: block;
    }
    .x span {
        display: block;
        color: var(--mut);
        font-size: 14px;
        margin-top: 2px;
    }
    details {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 10px 12px;
        margin: 14px 0;
    }
    summary {
        font-weight: 700;
        cursor: pointer;
    }
    details ul {
        margin: 8px 0 0;
        padding-left: 18px;
        color: var(--mut);
        font-size: 14px;
    }
    details li {
        padding: 2px 0;
    }
    .pn {
        display: flex;
        gap: 10px;
        margin: 16px 0 28px;
    }
    .pn button {
        flex: 1;
        padding: 13px;
        border-radius: 12px;
        border: 1px solid var(--line);
        background: var(--card);
        color: var(--fg);
        font: 600 15px inherit;
        font-family: inherit;
    }
    .pn button:disabled {
        opacity: 0.35;
    }
</style>

<script>
    const nav = document.getElementById("nav")!;
    const tabs = Array.from(nav.querySelectorAll<HTMLButtonElement>("button"));
    const sections = Array.from(document.querySelectorAll<HTMLElement>(".day"));
    let cur = 0;

    function show(i: number, keep = false) {
        i = Math.max(0, Math.min(sections.length - 1, i));
        cur = i;

        sections.forEach((s, k) => {
            s.hidden = k !== i;
        });
        tabs.forEach((b, k) =>
            b.setAttribute("aria-current", k === i ? "true" : "false"),
        );
        tabs[i].scrollIntoView({ inline: "center", block: "nearest" });

        // Sync the header accent with the visible day
        const acc = getComputedStyle(sections[i]).getPropertyValue("--acc");
        document.documentElement.style.setProperty("--acc", acc);

        if (!keep) {
            try {
                history.replaceState(null, "", "#d" + (i + 1));
            } catch (e) {}
        }
        try {
            localStorage.setItem("day", String(i));
        } catch (e) {}
        window.scrollTo(0, 0);
    }

    tabs.forEach((b, i) => b.addEventListener("click", () => show(i)));
    sections.forEach((s) => {
        s.querySelector(".pv")!.addEventListener("click", () => show(cur - 1));
        s.querySelector(".nx")!.addEventListener("click", () => show(cur + 1));
    });

    function start() {
        const m = /^#d(\d)$/.exec(location.hash);
        let i = 0;
        if (m) {
            i = +m[1] - 1;
        } else {
            try {
                const s = localStorage.getItem("day");
                if (s !== null) i = +s || 0;
            } catch (e) {}
        }
        show(i, true);
    }

    window.addEventListener("hashchange", () => {
        const m = /^#d(\d)$/.exec(location.hash);
        if (m && +m[1] - 1 !== cur) show(+m[1] - 1, true);
    });

    let sx = 0,
        sy = 0;
    document.addEventListener(
        "touchstart",
        (e) => {
            sx = e.touches[0].clientX;
            sy = e.touches[0].clientY;
        },
        { passive: true },
    );
    document.addEventListener(
        "touchend",
        (e) => {
            const dx = e.changedTouches[0].clientX - sx;
            const dy = e.changedTouches[0].clientY - sy;
            if (Math.abs(dx) > 70 && Math.abs(dy) < 40)
                show(cur + (dx < 0 ? 1 : -1));
        },
        { passive: true },
    );

    start();
</script>
