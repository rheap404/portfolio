---
// src/pages/thailand.astro (or src/components/ThailandTrip.astro)

interface Day {
    n: string; // tab label
    c: "travel" | "phuket" | "phiphi" | "oldtown" | "chiangrai" | "bangkok";
    d: string; // full date
    t: string; // title
    s: string; // where you sleep
    r: [string, string, string?][]; // [time, title, note?]
    m: string[]; // more things to do
}

const accents: Record<Day["c"], string> = {
    travel: "#6b7683",
    phuket: "#2e75b6",
    phiphi: "#0e8a8a",
    oldtown: "#8a4bc0",
    chiangrai: "#548235",
    bangkok: "#c55a11",
};

